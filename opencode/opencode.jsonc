{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": false,
  "default_agent": "design",
  "instructions": [],
  "experimental": {
    "todo": true
  },
  // Ordered rules: the last matching rule wins.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },

    { "action": "subagent", "resource": "explore", "effect": "allow" },
    { "action": "subagent", "resource": "prototype", "effect": "allow" },
    { "action": "subagent", "resource": "implement", "effect": "allow" },
    { "action": "subagent", "resource": "refine", "effect": "allow" },

    { "action": "skill", "resource": "customize-opencode", "effect": "allow" },
    { "action": "skill", "resource": "epic-description", "effect": "allow" },
    { "action": "skill", "resource": "ticket-description", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "rm*", "effect": "ask" },
    { "action": "shell", "resource": "mv*", "effect": "ask" },
    { "action": "shell", "resource": "dd*", "effect": "ask" },
    { "action": "shell", "resource": "shred*", "effect": "ask" },
    { "action": "shell", "resource": "truncate*", "effect": "ask" },

    { "action": "shell", "resource": "git *", "effect": "ask" },

    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list*", "effect": "allow" },
    { "action": "shell", "resource": "git show-ref*", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git format-patch*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git grep*", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base*", "effect": "allow" },
    { "action": "shell", "resource": "git describe*", "effect": "allow" },
    { "action": "shell", "resource": "git stash show*", "effect": "allow" },
    { "action": "shell", "resource": "git stash list*", "effect": "allow" },

    { "action": "shell", "resource": "git mv*", "effect": "ask" },
    { "action": "shell", "resource": "git rm*", "effect": "ask" },

    { "action": "shell", "resource": "git add*", "effect": "deny" },
    { "action": "shell", "resource": "git branch*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git restore*", "effect": "deny" },
    { "action": "shell", "resource": "git -C*", "effect": "deny" },

    // Read-only branch listing; must follow the "git branch*" deny.
    { "action": "shell", "resource": "git branch -a *", "effect": "allow" },
    { "action": "shell", "resource": "git branch -l *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list *", "effect": "allow" },

    { "action": "external_directory", "resource": "/tmp/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" }
  ]
}
