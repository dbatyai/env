{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": false,
  "instructions": [
  ],
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "explore": "allow",
    "todowrite": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": {
      "customize-opencode": "allow"
    },
    "bash": {
      "*": "allow",

      "rm*": "ask",
      "mv*": "ask",
      "dd*": "ask",
      "shred*": "ask",
      "truncate*": "ask",

      "git *": "ask",

      "git status*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git rev-list*": "allow",
      "git show-ref*": "allow",
      "git cat-file*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git format-patch*": "allow",
      "git branch *-[a|l]*": "allow",
      "git rev-parse*": "allow",
      "git grep*": "allow",
      "git merge-base*": "allow",
      "git describe*": "allow",
      "git stash show*": "allow",
      "git stash list*": "allow",

      "git add*": "deny",
      "git branch*": "deny",
      "git checkout*": "deny",
      "git clean*": "deny",
      "git commit*": "deny",
      "git mv*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git rm*": "deny",
      "git -C*": "deny"
    },
    "external_directory": {
      "/tmp/opencode": "allow",
      "/tmp/opencode/*": "allow",
      "/tmp/opencode/**": "allow"
    },
    "task": {
      "explore": "allow",
      "scout": "allow",
      "code-reviewer": "allow"
    }
  }
}
